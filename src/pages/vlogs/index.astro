---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVlogs } from '../../lib/vlogs';

const vlogs = await getVlogs();

function fmtDate(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  title="Design Vlog — Mimico Design House"
  description="Video episodes on UX practice, discovery, and design leadership from Mimico Design House."
>
  <div class="wrap">
    <div class="page-hd">
      <h1>Design Vlog</h1>
      <p class="lead">Raw conversations on discovery, design leadership, and what it actually takes to ship.</p>
    </div>

    <div class="vlog-list">
      {vlogs.map(vlog => (
        <a
          href={vlog.href}
          class="vbox"
          {...(vlog.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <div class="vth">
            {vlog.thumbnail && <img class="vth-img" src={vlog.thumbnail} alt="" loading="lazy" />}
            <div class="play">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="vb">
            <div class="tag">Design Vlog</div>
            <h4>{vlog.title}</h4>
            <div class="vm">EPISODE {vlog.episode} · {fmtDate(vlog.date).toUpperCase()}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
