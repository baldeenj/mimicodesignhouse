---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const portfolio = (await getCollection('portfolio'))
  .sort((a, b) => a.data.client.localeCompare(b.data.client));

// Thumbnail: explicit imageUrl, else the first figure image in the case study body.
function cardThumb(item: (typeof portfolio)[number]): string | null {
  if (item.data.imageUrl) return item.data.imageUrl;
  const m = item.body.match(/<img[^>]+src="([^"]+)"/);
  return m ? m[1] : null;
}

// Split into 3 contiguous columns for a staggered masonry wall. Contiguous
// chunks (not round-robin) keep the reading order intact when the columns
// collapse to one/two on smaller screens. Varied thumbnail aspect ratios give
// the layout an intentional, non-uniform rhythm.
const AR = ['ar-wide', 'ar-tall', 'ar-mid', 'ar-mid', 'ar-wide', 'ar-tall', 'ar-wide'];
const chunk = Math.ceil(portfolio.length / 3);
const columns: { item: (typeof portfolio)[number]; ar: string; thumb: string | null }[][] = [[], [], []];
portfolio.forEach((item, i) => {
  const ci = Math.min(Math.floor(i / chunk), 2);
  columns[ci].push({ item, ar: AR[i % AR.length], thumb: cardThumb(item) });
});
---

<BaseLayout
  title="Portfolio — Mimico Design House"
  description="Selected work from Mimico Design House — UX engagements across Canada's largest enterprises and public institutions."
>
  <div class="wrap">
    <div class="page-hd">
      <h1>Selected Work</h1>
      <p class="lead">Engagements across fintech, govtech, and enterprise SaaS — where the stakes are real and the margin for error is low.</p>
    </div>

    <div class="port-mosaic">
      {columns.map((col) => (
        <div class="pcol">
          {col.map(({ item, ar, thumb }) => (
            <a href={`/portfolio/${item.slug}/`} class="port-card">
              <div class={`port-thumb ${ar}`}>
                {thumb && <img src={thumb} alt="" loading="lazy" decoding="async" />}
              </div>
              <div class="port-body">
                <div class="cl">{item.data.client}</div>
                <h2>{item.data.title}</h2>
                <p>{item.data.description}</p>
                {item.data.tags.length > 0 && (
                  <div class="tags">
                    {item.data.tags.map(tag => <span class="tg">{tag}</span>)}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    (function () {
      var mosaic = document.querySelector(".port-mosaic");
      if (!mosaic) return;
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var cards = [].slice.call(mosaic.querySelectorAll(".port-card"));
      // Reduced-motion (or no rAF): leave cards static via --fx:none.
      if (reduce || !("requestAnimationFrame" in window)) return;
      mosaic.classList.add("fx-on");

      // Deterministic pseudo-random per card: each flies out from the screen's
      // bottom-right corner with its own tilt, jitter and stagger, so they stream
      // in at different rates and settle into the grid.
      function rand(s) { var x = Math.sin(s) * 43758.5453; return x - Math.floor(x); }
      cards.forEach(function (c, i) {
        var r1 = rand(i * 12.9 + 1.3), r2 = rand(i * 7.7 + 4.1), r3 = rand(i * 3.3 + 9.2), r4 = rand(i * 5.1 + 2.2);
        c._rot = (r3 - 0.5) * 42;               // dramatic random tilt
        c._phase = r4 * 0.20;                   // random stagger in the reveal window
        c._jx = (r1 - 0.5) * 160;               // small spread around the corner point
        c._jy = (r2 - 0.5) * 120;
        c._top = 0; c._left = 0;
      });

      function easeOut(t) { return 1 - Math.pow(1 - t, 3.2); }

      function apply() {
        var vw = document.documentElement.clientWidth;
        var vh = window.innerHeight;
        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
        var cornerX = vw + 80, cornerY = vh + 80; // just past the bottom-right corner
        var start = vh * 1.18, end = vh * 0.16;   // wide window so the long corner→slot travel reads
        for (var k = 0; k < cards.length; k++) {
          var c = cards[k];
          var restX = c._left, restY = c._top - y; // untransformed viewport position
          var t = (start - restY) / (start - end) - c._phase;
          t = t < 0 ? 0 : t > 1 ? 1 : t;
          var e = easeOut(t), inv = 1 - e;
          // Vector from the card's resting slot to the corner; at inv=1 it sits at the corner.
          var tx = inv * (cornerX + c._jx - restX);
          var ty = inv * (cornerY + c._jy - restY);
          c.style.setProperty("--fx",
            "translate3d(" + tx.toFixed(1) + "px," + ty.toFixed(1) + "px,0) rotate(" +
            (inv * c._rot).toFixed(2) + "deg) scale(" + (0.28 + 0.72 * e).toFixed(3) + ")");
          c.style.opacity = (t * 1.35 > 1 ? 1 : t * 1.35).toFixed(2);
        }
      }

      // Measure each card's untransformed document position (reset --fx first so
      // transforms don't feed back into the measurement).
      function measure() {
        cards.forEach(function (c) { c.style.setProperty("--fx", "none"); });
        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
        cards.forEach(function (c) {
          var r = c.getBoundingClientRect();
          c._top = r.top + y;
          c._left = r.left;
        });
        apply();
      }

      var ticking = false;
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(function () { ticking = false; apply(); }); } }
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", measure, { passive: true });
      window.addEventListener("load", measure);
      measure();
      setTimeout(measure, 400);
      setTimeout(measure, 1200); // re-measure after lazy images shift layout
    })();
  </script>
</BaseLayout>
