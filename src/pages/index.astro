---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const latestVlogs = (await getCollection('vlogs'))
  .sort((a, b) => b.data.episode - a.data.episode)
  .slice(0, 4);

const portfolioItems = (await getCollection('portfolio'))
  .filter(p => p.data.featured);
// one tile per client for the "Trusted at scale" grid (dedupe RBC, Air Canada, etc.)
const clients = [...new Map(portfolioItems.map(p => [p.data.client, p])).values()]
  .sort((a, b) => a.data.client.localeCompare(b.data.client));

function fmtDate(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
}

// Resolve a vlog thumbnail: explicit thumbnailUrl, else a YouTube still when the
// videoUrl carries a valid 11-char id, else null (falls back to a styled placeholder).
function vlogThumb(videoUrl: string, thumbnailUrl?: string): string | null {
  if (thumbnailUrl) return thumbnailUrl;
  const m = videoUrl.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})(?:[?&]|$)/);
  return m ? `https://img.youtube.com/vi/${m[1]}/hqdefault.jpg` : null;
}

// Cloudflare Turnstile site key (public). Set PUBLIC_TURNSTILE_SITE_KEY in your
// environment for production; the fallback is Cloudflare's "always passes" test key.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';

const services = [
  {
    no: '01',
    title: 'Advising & Coaching',
    summary: 'Bring clarity to complex transformation challenges through evidence-based research and HCI principles.',
    deliverables: ['Design & product team mentorship', 'Evidence-based transformation roadmap', 'Stakeholder alignment workshops'],
    methods: ['HCI principles', 'Facilitation', 'Coaching'],
  },
  {
    no: '02',
    title: 'Application Audits',
    summary: 'Uncover opportunities and design smarter solutions by combining UX expertise with technical rigor.',
    deliverables: ['Heuristic & accessibility evaluation', 'Prioritized opportunity backlog', 'Annotated audit report'],
    methods: ['WCAG', 'Heuristics', 'Analytics review'],
  },
  {
    no: '03',
    title: 'Collaborative Design',
    summary: 'Co-create solutions that balance usability with business impact through inclusive design practices.',
    deliverables: ['Facilitated design sprints', 'Interactive prototypes', 'Design-system foundations'],
    methods: ['Design sprints', 'Prototyping', 'Co-design'],
  },
  {
    no: '04',
    title: 'User Research',
    summary: 'Apply evidence-based methodologies to uncover real user needs and align every decision with goals.',
    deliverables: ['Generative & evaluative studies', 'Usability testing & synthesis', 'Personas & journey maps'],
    methods: ['Interviews', 'Usability testing', 'Journey mapping'],
  },
  {
    no: '05',
    title: 'Strategy Translation',
    summary: 'Turn research and design insight into clear, practical strategy that accelerates alignment.',
    deliverables: ['Product & experience strategy', 'Opportunity prioritization framework', 'Executive-ready narratives'],
    methods: ['Synthesis', 'Prioritization', 'Storytelling'],
  },
  {
    no: '06',
    title: 'Business Impact Analysis',
    summary: 'Improve the bottom line through data-driven UX that directly lifts conversion and retention.',
    deliverables: ['UX metrics & measurement plan', 'Conversion & retention analysis', 'ROI modeling'],
    methods: ['Analytics', 'A/B testing', 'ROI modeling'],
  },
];

// Method stages — rendered as a scrollytelling sequence (#process).
const method = [
  {
    no: '01', title: 'Discovery', dur: '1–2 weeks',
    outcome: 'A shared, evidence-grounded understanding of the problem — and what success looks like.',
    desc: 'Understand your challenges, goals, and current state through stakeholder interviews and context analysis.',
    artefacts: ['Stakeholder interviews', 'Current-state audit', 'Success metrics', 'Assumptions & risks'],
    tools: ['Miro', 'Dovetail', 'Notion'],
  },
  {
    no: '02', title: 'Research & Analysis', dur: '2–4 weeks',
    outcome: 'Validated user needs and a prioritized set of opportunities worth pursuing.',
    desc: 'Apply evidence-based research and HCI principles to uncover needs and surface real opportunities.',
    artefacts: ['Research findings', 'Personas & journey maps', 'Service blueprints', 'Opportunity backlog'],
    tools: ['Dovetail', 'Maze', 'Figma'],
  },
  {
    no: '03', title: 'Co-Creation', dur: '3–6 weeks',
    outcome: 'Tested, buildable designs the whole team is aligned behind.',
    desc: 'Design with your team to balance usability, technical feasibility, and business impact.',
    artefacts: ['Wireframes & prototypes', 'Information architecture', 'Design-system foundations', 'Co-design workshops'],
    tools: ['Figma', 'FigJam', 'Maze'],
  },
  {
    no: '04', title: 'Implementation', dur: 'Ongoing',
    outcome: 'A shipped experience — accessible, on-brand, and true to the design intent.',
    desc: 'Translate insight into action and coach your team through execution for sustainable success.',
    artefacts: ['Annotated specs & handoff', 'Accessibility (WCAG) checks', 'Design QA', 'Usability test results'],
    tools: ['Figma', 'Storybook', 'Jira'],
  },
  {
    no: '05', title: 'Measure & Iterate', dur: 'Continuous',
    outcome: 'Proof of impact and a clear, prioritized path for what comes next.',
    desc: 'Track the outcomes that matter, learn from real usage, and feed insight back into the next cycle.',
    artefacts: ['Success-metric dashboard', 'Post-launch analysis', 'Iteration backlog', 'Retrospective'],
    tools: ['GA4', 'Hotjar', 'Looker'],
  },
];
---

<BaseLayout>

<!-- HERO -->
<section class="hero-sec" id="top">
  <div class="hero-bg" role="img" aria-label="Designers seated around a table, talking and working together in a modern office"></div>
  <div class="hero-scrim"></div>
  <div class="wrap">
  <div class="hero">
    <div class="hero-top">
      <span class="label">Human-Centered Design</span>
    </div>
    <h1 class="hero-h">Human by<br />design. <span class="ac">Seamless</span><br />by execution.</h1>
    <div class="hero-split">
      <p class="hero-lede">We turn complex, data-rich enterprise products into experiences people <span class="acw">actually understand</span> — grounded in research, engineered to ship.</p>
      <div class="hero-card">
        <div class="ck">Start here</div>
        <p>Where is complexity slowing your product down?</p>
        <div class="cbtns">
          <a href="#contact" class="btn btn-primary">Start a conversation <span class="arr">→</span></a>
          <a href="/portfolio/" class="btn btn-dark" style="background:transparent;border:1.5px solid rgba(253,253,252,.35);color:var(--on-accent)">See selected work</a>
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marq" aria-hidden="true">
  <div class="marq-track">
    <span>Fintech</span><span>GovTech</span><span>AI-Driven SaaS</span><span>Enterprise Complexity</span><span>Data-Rich Environments</span><span>User Research</span><span>User-Centered Design</span><span>User Experience Design</span><span>Interaction Design</span><span>Service Design</span><span>User Personas</span><span>User Journey Mapping</span><span>User Flows</span><span>Service Blueprints</span><span>Stakeholder Management</span><span>Prototyping</span><span>Design Systems</span><span>WCAG and Design Accessibility Standards</span>
    <span>Fintech</span><span>GovTech</span><span>AI-Driven SaaS</span><span>Enterprise Complexity</span><span>Data-Rich Environments</span><span>User Research</span><span>User-Centered Design</span><span>User Experience Design</span><span>Interaction Design</span><span>Service Design</span><span>User Personas</span><span>User Journey Mapping</span><span>User Flows</span><span>Service Blueprints</span><span>Stakeholder Management</span><span>Prototyping</span><span>Design Systems</span><span>WCAG and Design Accessibility Standards</span>
  </div>
</div>

<!-- STATS -->
<div class="stats sec-angled">
  <div class="stat reveal"><div class="n">25+</div><div class="l">Years combined experience in HCI &amp; UX strategy</div></div>
  <div class="stat reveal"><div class="n">100+</div><div class="l">Product &amp; delivery teams coached</div></div>
  <div class="stat reveal"><div class="n">40%</div><div class="l">Average ROI increase across engagements</div></div>
</div>

<!-- SERVICES -->
<section id="services" class="sec-angled">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>What we offer</h2>
      <p class="lead">Six disciplines that take the work from first principles to a shipped, measurable outcome.</p>
    </div>
    <div class="svc-explorer reveal">
      <div class="svc-tabs" role="tablist" aria-label="What we offer" aria-orientation="vertical">
        {services.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`svc-tab-${i}`}
            class="svc-tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`svc-panel-${i}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="svc-tab-no">{s.no}</span>
            <span class="svc-tab-title">{s.title}</span>
            <span class="svc-tab-arr" aria-hidden="true">→</span>
          </button>
        ))}
      </div>
      <div class="svc-panels">
        {services.map((s, i) => (
          <div
            role="tabpanel"
            id={`svc-panel-${i}`}
            class="svc-panel"
            aria-labelledby={`svc-tab-${i}`}
            tabindex="0"
            hidden={i !== 0}
          >
            <div class="svc-panel-no">{s.no} — Service</div>
            <h3>{s.title}</h3>
            <p class="svc-panel-sum">{s.summary}</p>
            <div class="svc-panel-cols">
              <div class="svc-deliv">
                <h4>What you get</h4>
                <ul>
                  {s.deliverables.map((d) => <li>{d}</li>)}
                </ul>
              </div>
              <div class="svc-meth">
                <h4>Methods</h4>
                <div class="svc-tags">
                  {s.methods.map((m) => <span class="svc-tag">{m}</span>)}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  "use strict";
  const tablist = document.querySelector(".svc-tabs");
  if (!tablist) return;
  const tabs = Array.prototype.slice.call(tablist.querySelectorAll('[role="tab"]'));
  const panels = tabs.map(function (t) { return document.getElementById(t.getAttribute("aria-controls")); });

  function select(idx, focus) {
    tabs.forEach(function (tab, i) {
      const active = i === idx;
      tab.setAttribute("aria-selected", active ? "true" : "false");
      tab.tabIndex = active ? 0 : -1;
      if (panels[i]) panels[i].hidden = !active;
    });
    if (focus) tabs[idx].focus();
  }

  tabs.forEach(function (tab, i) {
    tab.addEventListener("click", function () { select(i, false); });
    tab.addEventListener("keydown", function (e) {
      let next = null;
      if (e.key === "ArrowDown" || e.key === "ArrowRight") next = (i + 1) % tabs.length;
      else if (e.key === "ArrowUp" || e.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === "Home") next = 0;
      else if (e.key === "End") next = tabs.length - 1;
      if (next !== null) { e.preventDefault(); select(next, true); }
    });
  });
})();
</script>

<!-- PORTFOLIO / CLIENTS -->
<section id="work" class="clients">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>Trusted at scale</h2>
      <p class="lead">50+ teams across Canada's largest enterprises and public institutions — where compliance and scale leave no margin for guesswork.</p>
    </div>
    <div class="cli reveal">
      {clients.map(item => (
        <a href={`/portfolio/${item.slug}/`} class="c">
          <div class="nm">{item.data.client}</div>
        </a>
      ))}
    </div>
    <div style="margin-top:30px"><a href="/portfolio/" class="btn btn-line">View the portfolio <span class="arr">→</span></a></div>
  </div>
</section>

<!-- PROCESS -->
<section id="process" class="sec-angled">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>How we work</h2>
      <p class="lead">A collaborative, evidence-based method built to drive alignment and accelerate execution.</p>
    </div>
    <div class="scrolly reveal">
      <!-- sticky progress rail — stays pinned while the stages scroll past -->
      <aside class="scrolly-viz">
        <nav class="mrail" aria-label="Method stages">
          <div class="mrail-line" aria-hidden="true"><span class="mrail-fill"></span></div>
          {method.map((m, i) => (
            <button type="button" class={`mrail-step${i === 0 ? ' active' : ''}`} data-i={i} aria-label={`Jump to stage ${m.no}: ${m.title}`}>
              <span class="mrail-dot" aria-hidden="true"></span>
              <span class="mrail-label"><span class="mrail-no">{m.no}</span><span class="mrail-title">{m.title}</span></span>
            </button>
          ))}
        </nav>
        <div class="mrail-note">
          {method.map((m, i) => (
            <p class={`mrail-outcome${i === 0 ? ' active' : ''}`} data-i={i}>
              <span class="mrail-kick">Outcome</span>{m.outcome}
            </p>
          ))}
        </div>
      </aside>

      <!-- the scrolling stages -->
      <div class="msteps">
        {method.map((m, i) => (
          <article class={`mstep${i === 0 ? ' active' : ''}`} data-i={i}>
            <div class="mstep-top">
              <span class="mstep-no">{m.no}</span>
              <span class="mstep-dur">{m.dur}</span>
            </div>
            <h3 class="mstep-title">{m.title}</h3>
            <p class="mstep-desc">{m.desc}</p>
            <div class="pgroup"><div class="plabel">Artefacts</div><div class="parts">{m.artefacts.map(a => <span class="part">{a}</span>)}</div></div>
            <div class="pgroup"><div class="plabel">Tools</div><div class="parts tools">{m.tools.map(t => <span class="part">{t}</span>)}</div></div>
          </article>
        ))}
      </div>
    </div>
    <script is:inline>
      function initScrolly(scrolly) {
        var steps = [].slice.call(scrolly.querySelectorAll(".mstep"));
        var railSteps = [].slice.call(scrolly.querySelectorAll(".mrail-step"));
        var outcomes = [].slice.call(scrolly.querySelectorAll(".mrail-outcome"));
        var fill = scrolly.querySelector(".mrail-fill");
        var n = steps.length, current = -1;
        function setActive(i) {
          if (i === current) return;
          current = i;
          steps.forEach(function (s, k) { s.classList.toggle("active", k === i); });
          railSteps.forEach(function (s, k) {
            s.classList.toggle("active", k === i);
            s.classList.toggle("done", k < i);
          });
          outcomes.forEach(function (o, k) { o.classList.toggle("active", k === i); });
          if (fill) fill.style.height = (n > 1 ? (i / (n - 1)) * 100 : 0) + "%";
        }
        // Clicking a rail step scrolls its stage to the viewport centre.
        railSteps.forEach(function (btn) {
          btn.addEventListener("click", function () {
            var target = steps[+btn.getAttribute("data-i")];
            if (target) target.scrollIntoView({ behavior: "smooth", block: "center" });
          });
        });
        if (!("IntersectionObserver" in window)) { setActive(0); return; }
        // A thin band across the viewport centre; whichever step crosses it is active.
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) setActive(+e.target.getAttribute("data-i"));
          });
        }, { rootMargin: "-48% 0px -48% 0px", threshold: 0 });
        steps.forEach(function (s) { io.observe(s); });
        setActive(0);
      }
      document.querySelectorAll(".scrolly").forEach(initScrolly);
    </script>
  </div>
</section>

<!-- INSIGHTS -->
<section id="insights">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>Insights</h2>
      <p class="lead">Research, AI, and systems thinking from the studio.</p>
    </div>
    <div class="home-grid reveal">
      {articles.map(article => (
        <a href={`/articles/${article.slug}/`} class="ins-card">
          <div class="ins-thumb">
            {article.data.heroImage && (
              <img src={article.data.heroImage} alt="" loading="lazy" decoding="async" />
            )}
          </div>
          <div class="ins-body">
            <div class="tag">{article.data.tag}</div>
            <h4>{article.data.title}</h4>
            <div class="ins-card-ft">
              <span class="dt">{fmtDate(article.data.date)}</span>
              <span class="arr">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="sec-more reveal"><a href="/articles/" class="btn btn-line">All articles <span class="arr">→</span></a></div>
  </div>
</section>

<!-- VLOGS -->
<section id="vlogs" class="sec-angled">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>Vlogs</h2>
      <p class="lead">Short videos on design, research, and delivery.</p>
    </div>
    <div class="home-grid reveal">
      {latestVlogs.map(vlog => {
        const thumb = vlogThumb(vlog.data.videoUrl, vlog.data.thumbnailUrl);
        return (
          <a href={`/vlogs/${vlog.slug}/`} class="vbox">
            <div class="vth">
              {thumb && <img class="vth-img" src={thumb} alt="" loading="lazy" />}
              <div class="play"><svg width="22" height="22" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></div>
            </div>
            <div class="vb">
              <div class="tag">Episode {vlog.data.episode}</div>
              <h4>{vlog.data.title}</h4>
              <div class="vm">{fmtDate(vlog.data.date).toUpperCase()}</div>
            </div>
          </a>
        );
      })}
    </div>
    <div class="sec-more reveal"><a href="/vlogs/" class="btn btn-line">All vlogs <span class="arr">→</span></a></div>
  </div>
</section>

<!-- CTA -->
<section id="contact" class="cta sec-angled">
  <img class="cta-mark" src="/assets/img/mdh-mark.png" alt="" aria-hidden="true" />
  <div class="wrap">
    <span class="label">Start a conversation</span>
    <h2>Let's build something people understand.</h2>
    <p>Tell us where complexity is slowing you down. We'll uncover the opportunity, design the smarter solution, and ship experiences that move the bottom line.</p>

    <form id="contactForm" class="cta-form" novalidate>
      <div class="cf-grid">
        <label class="cf-field">
          <span class="cf-lab">Name</span>
          <input type="text" name="name" required autocomplete="name" maxlength="120" />
        </label>
        <label class="cf-field">
          <span class="cf-lab">Email</span>
          <input type="email" name="email" required autocomplete="email" maxlength="200" />
        </label>
      </div>
      <label class="cf-field">
        <span class="cf-lab">Company <em>optional</em></span>
        <input type="text" name="company" autocomplete="organization" maxlength="160" />
      </label>
      <label class="cf-field">
        <span class="cf-lab">Where is complexity slowing you down?</span>
        <textarea name="message" rows="4" required maxlength="4000"></textarea>
      </label>

      <!-- Honeypot: hidden from humans, catches naive bots -->
      <input type="text" name="website" class="cf-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>

      <div class="cf-actions">
        <button type="submit" class="btn btn-primary">Send message <span class="arr">→</span></button>
      </div>

      <p class="cf-status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
(function () {
  "use strict";
  const form = document.getElementById("contactForm");
  if (!form) return;
  const statusEl = form.querySelector(".cf-status");
  const btn = form.querySelector("button[type=submit]");

  function setStatus(msg, kind) {
    statusEl.textContent = msg;
    statusEl.hidden = false;
    statusEl.className = "cf-status" + (kind ? " is-" + kind : "");
  }

  form.addEventListener("submit", async function (e) {
    e.preventDefault();

    // Honeypot tripped — pretend success, do nothing.
    if (form.website && form.website.value) { setStatus("Thanks — we'll be in touch.", "ok"); return; }

    if (!form.checkValidity()) { form.reportValidity(); return; }

    const token = (form.querySelector('[name="cf-turnstile-response"]') || {}).value;
    if (!token) { setStatus("Please complete the verification challenge and try again.", "err"); return; }

    btn.disabled = true;
    setStatus("Sending…", "");

    try {
      const res = await fetch("/api/contact", { method: "POST", body: new FormData(form) });
      const data = await res.json().catch(function () { return {}; });
      if (res.ok) {
        form.reset();
        if (window.turnstile) window.turnstile.reset();
        setStatus("Thanks — your message is on its way. We'll reply within a couple of business days.", "ok");
      } else {
        if (window.turnstile) window.turnstile.reset();
        setStatus(data.error || "Something went wrong. Please email us directly at hello@mimicodesignhouse.com.", "err");
      }
    } catch (err) {
      setStatus("Network error. Please email us directly at hello@mimicodesignhouse.com.", "err");
    } finally {
      btn.disabled = false;
    }
  });
})();
</script>

</BaseLayout>
